# Build local del fork. Contexto esperado: ~/dev (contiene mozhi/ y libmozhi/)
FROM golang:alpine AS build
WORKDIR /src
RUN apk --no-cache add ca-certificates

# Copiamos AMBOS repos, respetando la ruta del replace (../libmozhi)
COPY mozhi/ ./mozhi/
COPY libmozhi/ ./libmozhi/

WORKDIR /src/mozhi
RUN go mod download
ENV CGO_ENABLED=0 GOOS=linux
RUN go build -ldflags="-s -w" -o /src/mozhi/mozhi .

FROM scratch AS runtime
WORKDIR /app
COPY --from=build /etc/ssl/certs/ca-certificates.crt /etc/ssl/certs/ca-certificates.crt
COPY --from=build /src/mozhi/mozhi /app/mozhi
EXPOSE 3000
ENTRYPOINT ["/app/mozhi", "serve"]